+def _clean_columns(df: pd.DataFrame) -> pd.DataFrame:
+    """Strip a stray byte-order-mark (shows up as 'ï»¿Year') from column names."""
+    def fix(c):
+        if isinstance(c, str):
+            for junk in _BOM_JUNK:
+                c = c.replace(junk, "")
+            return c.strip()
+        return c
+    df.columns = [fix(c) for c in df.columns]
+    return df
