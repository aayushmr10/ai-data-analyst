# Copy to .env (never commit .env). Docker Compose reads it automatically.

# Enables the AI analyst (chat, briefings, root-cause). Gemini API has a free tier.
# Get a key at https://aistudio.google.com/apikey and keep it private.
GEMINI_API_KEY=

# Optional fallback provider (only used when GEMINI_API_KEY is blank).
ANTHROPIC_API_KEY=

# Gemini model supporting function calling.
LLM_MODEL=gemini-2.5-flash

# Max tool-calling steps per request (2-15). Higher = deeper investigations, more cost.
LLM_MAX_STEPS=8

# ---- Public-deployment protection (recommended for any shared URL) ----
# If set, the AI endpoints require this code (users enter it once per browser session).
APP_ACCESS_CODE=
# Per-IP AI requests per hour (0 = off) and a global cap per day (0 = off). The daily cap is
# your hard ceiling on spend if the URL leaks.
AI_RATE_LIMIT_PER_HOUR=30
AI_DAILY_CAP=300
# Largest accepted upload. Use ~5 on 512 MB hosts (e.g. Render free), ~25 on Hugging Face Spaces.
MAX_UPLOAD_MB=25
# Idle minutes before a dataset session is dropped, and the max sessions held in memory.
SESSION_TTL_MIN=60
MAX_SESSIONS=25
# Split deployments only: allowed browser origin(s) for the API, comma-separated.
# CORS_ORIGINS=https://your-app.vercel.app
